{
  "rules": {
    "pump": {
      // Seuls les utilisateurs connectés (l'ESP32 via son compte dédié et vous via l'application) peuvent lire ou écrire
      ".read": "auth != null",
      ".write": "auth != null",

      // Validation stricte des données pour éviter les erreurs ou piratages
      "relay_state": {
        ".validate": "newData.isString() && (newData.val() == 'ON' || newData.val() == 'OFF')"
      },
      "mode": {
        ".validate": "newData.isString() && (newData.val() == 'AUTO' || newData.val() == 'MANUAL' || newData.val() == 'MAINTENANCE')"
      },
      "set_mode": {
        ".validate": "newData.isString() && (newData.val() == 'AUTO' || newData.val() == 'MANUAL' || newData.val() == 'MAINTENANCE' || newData.val() == 'IDLE')"
      },
      "command_state": {
        ".validate": "newData.isString() && (newData.val() == 'ON' || newData.val() == 'OFF' || newData.val() == 'IDLE')"
      },
      "level_high": {
        ".validate": "newData.isBoolean()"
      },
      "level_low": {
        ".validate": "newData.isBoolean()"
      },
      "last_seen": {
        ".validate": "newData.isNumber()"
      },
      "ota_url": {
        ".validate": "newData.isString()"
      },
      "fault": {
        ".validate": "newData.isString()"
      },
      "logs": {
        ".indexOn": ["ts"],
        "$logId": {
          ".validate": "newData.hasChildren(['category', 'message', 'sev', 'ts'])",
          "category": { ".validate": "newData.isString()" },
          "message": { ".validate": "newData.isString()" },
          "sev": { ".validate": "newData.isString()" },
          "ts": { ".validate": "newData.isString()" }
        }
      }
    }
  }
}
